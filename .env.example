# Public URL of your deployed site (no trailing slash)
BASE_URL=https://your-domain.com
# Long random string: openssl rand -hex 32
SESSION_SECRET=
# Admin dashboard password (use a long one)
ADMIN_PASSWORD=
# Instagram API with Instagram Login (Meta developer dashboard). Leave blank to use username-entry only.
IG_APP_ID=
IG_APP_SECRET=
# SQLite file location (use a persistent disk in production)
DB_PATH=./data.db
